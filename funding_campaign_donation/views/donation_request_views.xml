<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View donation.request View Tree -->
    <record id="view_donation_request_tree" model="ir.ui.view">
        <field name="name">view.donation.request.tree</field>
        <field name="model">donation.request</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-muted="state == 'cancelled'" decoration-success="state == 'approved'" decoration-warning="state == 'waiting'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="email"/>
                <field name="donation_amount" sum="Total"/>
                <field name="campaign_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="donation_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- View donation.request form -->
    <record id="view_donation_request_form" model="ir.ui.view">
        <field name="name">view.donation.request.form</field>
        <field name="model">donation.request</field>
        <field name="arch" type="xml">
            <form string="Donation Request">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_waiting" string="Put on Waiting List" type="object" invisible="state != 'draft'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'draft' and state != 'waiting'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft' and state != 'waiting'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_donation" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="donation_id == False">
                            <field name="donation_id" string="Donation" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="campaign_id"/>
                            <field name="donation_amount"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="payment_mode_id" domain="[('donation', '=', True)]" required="state == 'draft'"/>
                            <field name="tax_receipt_option"/>
                            <field name="date"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="firstname"/>
                            <field name="lastname"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="vat"/>
                            <field name="lang"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address Information">
                            <group>
                                <group>
                                    <field name="address"/>
                                    <field name="city"/>
                                    <field name="zip_code"/>
                                </group>
                                <group>
                                    <field name="state_id"/>
                                    <field name="country_id"/>
                                    <field name="zip_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View donation.request search -->
    <record id="view_donation_request_search" model="ir.ui.view">
        <field name="name">view.donation.request.search</field>
        <field name="model">donation.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="email"/>
                <field name="vat"/>
                <field name="campaign_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting" name="waiting" domain="[('state', '=', 'waiting')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Website" name="website" domain="[('source', '=', 'website')]"/>
                <filter string="Manual" name="manual" domain="[('source', '=', 'manual')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('date', '>=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('date', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today().replace(day=1) + datetime.timedelta(days=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="1" string="Group By">
                    <filter string="State" name="state" domain="[]" context="{'group_by':'state'}"/>
                    <filter string="Campaign" name="campaign" domain="[]" context="{'group_by':'campaign_id'}"/>
                    <filter string="Partner" name="partner" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter string="Date" name="date" domain="[]" context="{'group_by':'date'}"/>
                    <filter string="Source" name="source" domain="[]" context="{'group_by':'source'}"/>
                    <filter string="Company" name="company" domain="[]" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action donation.request -->
    <record id="action_donation_request" model="ir.actions.act_window">
        <field name="name">Donation Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">donation.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new donation request
            </p>
            <p>
                Donation requests can be created manually or automatically from the website.
                Once approved, they will generate donation records.
            </p>
        </field>
    </record>

    <!-- Menu item for donation.request -->
    <menuitem id="menu_donation_request"
              name="Donation Requests"
              parent="donation.donation_title_menu"
              action="action_donation_request"
              sequence="20"/>

    <!-- Campaign donation requests action -->
    <record id="action_campaign_donation_request" model="ir.actions.act_window">
        <field name="name">Donation Requests</field>
        <field name="res_model">donation.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('campaign_id', '=', active_id)]</field>
        <field name="context">{'default_campaign_id': active_id}</field>
    </record>

    <!-- Add button to campaign form view -->
    <record id="view_funding_campaign_form_donation_request" model="ir.ui.view">
        <field name="name">funding.campaign.form.donation.request</field>
        <field name="model">funding.campaign</field>
        <field name="inherit_id" ref="funding_campaign.view_funding_campaign_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="funding_source_ids" invisible="1"/>
                <button name="%(action_campaign_donation_request)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o">
                    <field name="donation_request_count" widget="statinfo" string="Donation Requests"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
