<odoo>
    <record id="funding_subscription_request_tree_inherit" model="ir.ui.view">
        <field name="name">funding.subscription.request.tree.inherit</field>
        <field name="model">subscription.request</field>
        <field name="inherit_id" ref="cooperator.subscription_request_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-info">state == 'draft'</attribute>
                <attribute name="decoration-muted">state == 'cancelled'</attribute>
                <attribute name="decoration-success">state == 'done'</attribute>
                <attribute name="decoration-warning">state == 'waiting'</attribute>
                <attribute name="decoration-danger">state == 'blocked'</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='state']" position="after">
                <field name="signature_state" string="Signature" widget="badge"/>
            </xpath>
            <field name="source" position="after">
                <field name="campaign_id"/>
            </field>
        </field>
    </record>
    
    <record id="funding_subscription_request_form_inherit" model="ir.ui.view">
        <field name="name">funding.subscription.request.form.inherit</field>
        <field name="model">subscription.request</field>
        <field name="inherit_id" ref="cooperator.subscription_request_view_form"/>
        <field name="arch" type="xml">
            <field name="source" position="after">
                <field name="campaign_id"
                       options="{'no_create': True}"
                       readonly="state != 'draft'"/>
                <field name="signature_state" string="Signature" widget="badge" readonly="1"/>
            </field>

            <!-- Añadir botón de firma digital después de los botones existentes -->
            <xpath expr="//header/button[@name='cancel_subscription_request']" position="after">
                <button name="action_send_for_signature"
                        string="Send for Signature"
                        type="object"
                        class="btn-primary"
                        invisible="state in ['draft', 'cancel'] or not campaign_id"
                        groups="cooperator.cooperator_group_manager"/>
                <button name="action_send_campaign_confirmation_email"
                        string="Send Campaign Confirmation"
                        type="object"
                        class="btn-secondary"
                        invisible="not campaign_id"/>
            </xpath>

            <!-- Banner de guía rápida -->
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-info" role="alert" style="margin-bottom: 12px;">
                    <strong><i class="fa fa-info-circle"/> Quick guide:</strong>
                    <span>This subscription belongs to a <strong>funding campaign</strong>. When it is validated and paid, the corresponding <strong>contribution</strong> is created automatically (no loan). Send the contract with <strong>Send for Signature</strong> and, when the member signs it, it will be linked. See the <strong>User Guide</strong> tab.</span>
                </div>
            </xpath>
            
            <!-- Añadir notebook con información de firma -->
            <xpath expr="//notebook" position="inside">
                <page string="Digital Signature" name="digital_signature">
                    <group>
                        <group string="Signature Information">
                            <field name="sign_request_count"/>
                            <button name="action_view_sign_requests"
                                    string="View Sign Requests"
                                    type="object"
                                    class="oe_link"
                                    invisible="sign_request_count == 0"/>
                        </group>
                        <group string="Signed Document">
                            <field name="signed_contract" filename="signed_contract_filename"/>
                            <field name="signed_contract_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Signature Details" invisible="not signed_contract">
                        <group string="Partner Signature">
                            <field name="partner_signed_date"/>
                            <field name="partner_signed_user_id"/>
                        </group>
                        <group string="Company Signature">
                            <field name="company_signed_date"/>
                            <field name="company_signed_user_id"/>
                        </group>
                    </group>
                </page>
                <page string="User Guide" name="usage_guide">
                    <div class="alert alert-success" role="alert">
                        <strong><i class="fa fa-lightbulb-o"/> How does a campaign subscription work?</strong>
                        <p>The member makes a subscription to a funding campaign. When it is validated and paid, the system creates the corresponding contribution automatically (no loan). The contract is sent for signature and linked to the contribution.</p>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <h5>1. Create the subscription</h5>
                            <p>Indicate the <strong>campaign</strong>, the member, the number of shares and the remuneration type (cash or wallet).</p>
                        </div>
                        <div class="col-6">
                            <h5>2. Send the contract</h5>
                            <p>Use <strong>Send for Signature</strong> to send the subscription contract with digital signature. When the member signs it, it is saved automatically.</p>
                        </div>
                        <div class="col-6">
                            <h5>3. Validation and payment</h5>
                            <p>Validating the subscription generates the invoice. If automatic payment is enabled on the company, it is paid automatically; otherwise, the payment must be registered manually.</p>
                        </div>
                        <div class="col-6">
                            <h5>4. Automatic contribution</h5>
                            <p>When the subscription changes to <strong>paid</strong>, the contribution is created automatically in the contributions module with the same amounts, the signed contract and the linked campaign.</p>
                        </div>
                    </div>
                    <div class="alert alert-warning" role="alert">
                        <strong><i class="fa fa-exclamation-triangle"/> Important:</strong>
                        <span>Campaign subscriptions <strong>do not generate loans</strong> (loans only for subscriptions without a campaign, for backward compatibility).</span>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    
    <!-- 2026: el flujo de préstamos queda obsoleto — las suscripciones de campaña generan
         aportación (carsharing.contribution) directamente, sin loan. Se oculta la pestaña
         "Loan request" inyectada por cooperator_share_increase_loan. -->
    <record id="funding_hide_loan_request_page" model="ir.ui.view">
        <field name="name">funding.subscription.request.form.hide.loan</field>
        <field name="model">subscription.request</field>
        <field name="inherit_id" ref="cooperator.subscription_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='loan_request']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="funding_view_subscription_request_filter_inherit" model="ir.ui.view">
        <field name="name">funding.subscription.request.search.inherit</field>
        <field name="model">subscription.request</field>
        <field name="inherit_id" ref="cooperator.view_subscription_request_filter"/>
        <field name="arch" type="xml">
            <!-- Añadir filtros de firma después del filtro de IBAN inválido -->
            <filter name="is_valid_iban" position="after">
                <separator/>
                <filter string="Signed"
                        name="filter_signed"
                        domain="[('is_signed', '=', True)]"
                        help="Show only signed subscription requests"/>
                <filter string="Not Signed"
                        name="filter_not_signed"
                        domain="[('is_signed', '=', False)]"
                        help="Show only unsigned subscription requests"/>
                <filter string="Pending Signature"
                        name="filter_pending_signature"
                        domain="[('signature_state', '=', 'pending')]"
                        help="Show subscription requests with pending signatures"/>
                <filter string="Partially Signed"
                        name="filter_partially_signed"
                        domain="[('signature_state', '=', 'partial')]"
                        help="Show subscription requests with partial signatures"/>
            </filter>
            
            <!-- Añadir campos de búsqueda para firma -->
            <field name="partner_id" position="after">
                <field name="campaign_id"/>
                <field name="signature_state" string="Signature State"/>
                <field name="is_signed" string="Is Signed"/>
            </field>
            
            <!-- Añadir agrupaciones -->
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter name="campaign_id"
                        string="Campaign"
                        context="{'group_by': 'campaign_id'}"/>
                <filter name="group_by_signature_state"
                        string="Signature State"
                        context="{'group_by': 'signature_state'}"/>
            </xpath>
        </field>
    </record>
</odoo>
